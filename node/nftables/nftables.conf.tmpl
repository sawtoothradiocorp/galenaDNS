#!/usr/sbin/nft -f
#
# galena-dns host firewall.
#
# This mirrors the Hetzner Cloud Firewall rather than replacing it. Two
# independent layers means a mistake in either one does not expose a port.
#
# There is deliberately not a single `log` statement in this ruleset. An
# nftables log would write client IP addresses into journald, which would break
# the no-logging guarantee from the one place nobody thinks to look.
# Counters are fine: they are aggregate and hold no addresses.

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        iif lo accept

        # --- ICMPv4 -------------------------------------------------------
        # "fragmentation-needed" is not optional. QUIC depends on path MTU
        # discovery, and dropping this produces the worst kind of bug: DoQ and
        # DoH3 work from most networks and hang from a few.
        ip protocol icmp icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept
        ip protocol icmp icmp type echo-request limit rate 10/second accept

        # --- ICMPv6 -------------------------------------------------------
        # packet-too-big is the IPv6 equivalent and matters even more, since
        # IPv6 routers never fragment. Neighbour discovery is what makes IPv6
        # work at all, so dropping it silently breaks the whole address family.
        icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept
        icmpv6 type echo-request limit rate 10/second accept

        # --- Encrypted DNS ------------------------------------------------
        tcp dport { 443, 853 } accept comment "DoH, DoT"
        udp dport { 443, 853 } accept comment "DoH3, DoQ (QUIC)"

        # --- Management ---------------------------------------------------
        # Generated by bootstrap.sh: `ip saddr` for an IPv4 admin_cidr,
        # `ip6 saddr` for an IPv6 one. Mixing the two is a syntax error, so the
        # correct family is chosen there rather than guessed here.
${GALENA_NFT_ADMIN_RULES}

        # Plain DNS is never accepted from the network. unbound binds loopback
        # only, so this is belt-and-braces over an already-closed door — but it
        # makes the intent explicit and gives the audit something to assert.
        tcp dport 53 drop comment "no public plain DNS"
        udp dport 53 drop comment "no public plain DNS"

        # Port 80 is absent: ACME uses DNS-01, so no HTTP server ever runs here.
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        # Egress stays open: 853 for the upstream resolver, 443 for ACME and
        # blocklist fetches, and 53 during cloud-init before unbound exists (and
        # for full recursion if forward_tls_upstreams is emptied).
        type filter hook output priority filter; policy accept;
    }
}
