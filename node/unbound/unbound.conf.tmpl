# galena-dns — unbound validating resolver
#
# Rendered by bootstrap.sh; do not edit on the node, edit node/unbound/ and re-deploy.
#
# Role: DNSSEC-validating resolver reachable only from localhost. dnsdist owns the
# public listeners and forwards here.
#
# Resolution posture is set by var.forward_tls_upstreams and rendered into the
# forward-zone block at the bottom of this file. Either it forwards the root zone
# over authenticated DNS-over-TLS, or — with an empty list — it recurses from the
# root in cleartext. DNSSEC is validated HERE in both cases, so an upstream is
# only ever trusted to relay, never to tell the truth.

server:
    # ---------------------------------------------------------------------
    # Privacy. Nothing about a query reaches disk, and the audit script
    # asserts each of these at runtime via `unbound-control get_option`.
    # ---------------------------------------------------------------------
    verbosity: 0
    use-syslog: no
    logfile: ""
    log-queries: no
    log-replies: no
    log-local-actions: no
    log-servfail: no
    log-tag-queryreply: no
    log-destaddr: no
    statistics-interval: 0
    statistics-cumulative: no
    extended-statistics: no

    # Do not advertise what we are or what trust anchors we hold.
    hide-identity: yes
    hide-version: yes
    hide-trustanchor: yes
    hide-http-user-agent: yes
    identity: ""
    version: ""

    # ---------------------------------------------------------------------
    # Listeners: loopback only. Nothing here is reachable from the internet,
    # which is what makes "port 53 is closed" true by construction rather
    # than by firewall rule alone.
    # ---------------------------------------------------------------------
    interface: 127.0.0.1
    interface: ::1
    port: 53
    do-ip4: yes
    do-ip6: yes
    do-udp: yes
    do-tcp: yes
    prefer-ip6: no

    access-control: 0.0.0.0/0 refuse
    access-control: ::/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: ::1 allow

    # ---------------------------------------------------------------------
    # Modules. `respip` must come first so response-policy processing runs on
    # every query — it is what makes RPZ work at all, and specifically what
    # makes the response-IP threat zone possible.
    # ---------------------------------------------------------------------
    module-config: "respip validator iterator"

    # No EDNS Client Subnet. Debian's unbound IS built with the subnetcache
    # module, so this is a matter of not loading it rather than it being
    # unavailable: module-config above deliberately omits it, and no
    # send-client-subnet option is set anywhere. privacy-audit.sh asserts both,
    # and verifies a client sending ECS gets no ECS back.

    # CA bundle for verifying upstream DoT certificates. Without this, a
    # forward-addr carrying #tls-auth-name cannot be authenticated and unbound
    # refuses to use it, so this line is load-bearing whenever forwarding is on.
    tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

    # ---------------------------------------------------------------------
    # DNSSEC validation
    # ---------------------------------------------------------------------
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
    root-hints: "/usr/share/dns/root.hints"
    val-clean-additional: yes
    harden-dnssec-stripped: yes
    harden-glue: yes
    harden-below-nxdomain: yes
    harden-large-queries: yes
    harden-short-bufsize: yes
    aggressive-nsec: yes

    # ---------------------------------------------------------------------
    # Upstream query privacy
    # ---------------------------------------------------------------------
    # qname-minimisation limits what each nameserver in a recursion chain learns.
    # It is worth much less than it looks against a network observer, who sees
    # every step of the chain and reassembles the full name from the parts. It is
    # also mostly moot while forwarding, since the full name goes to the upstream
    # in one encrypted query. Kept on because it costs nothing and it matters
    # again the moment forward_tls_upstreams is emptied.
    qname-minimisation: yes
    qname-minimisation-strict: no
    use-caps-for-id: no

    # ---------------------------------------------------------------------
    # Performance. Cache sizes are set deliberately rather than left at the
    # defaults. They were sized when RPZ claimed 0.9-1.2 GB of RSS; with the
    # 1.75M-entry domain malware feed moved upstream that is down to roughly
    # 250 MB, so these have room to grow. See var.unbound_msg_cache_size.
    # ---------------------------------------------------------------------
    num-threads: ${GALENA_NUM_THREADS}
    msg-cache-size: ${GALENA_UNBOUND_MSG_CACHE}
    rrset-cache-size: ${GALENA_UNBOUND_RRSET_CACHE}
    msg-cache-slabs: ${GALENA_CACHE_SLABS}
    rrset-cache-slabs: ${GALENA_CACHE_SLABS}
    infra-cache-slabs: ${GALENA_CACHE_SLABS}
    key-cache-slabs: ${GALENA_CACHE_SLABS}

    outgoing-range: 8192
    num-queries-per-thread: 4096
    so-reuseport: yes
    so-rcvbuf: 4m
    so-sndbuf: 4m

    prefetch: yes
    prefetch-key: yes
    serve-expired: yes
    serve-expired-ttl: 3600
    rrset-roundrobin: yes
    minimal-responses: yes

    # 1232 avoids IP fragmentation on virtually every path (DNS Flag Day 2020).
    # Fragmented DNS is both a reliability and a spoofing problem.
    edns-buffer-size: 1232

    # ---------------------------------------------------------------------
    # Process
    # ---------------------------------------------------------------------
    username: "unbound"
    directory: "/etc/unbound"
    # Debian does not chroot unbound; an empty value keeps absolute paths honest.
    chroot: ""
    pidfile: "/run/unbound.pid"

    do-not-query-localhost: yes
    unwanted-reply-threshold: 10000000

remote-control:
    # Unix socket only — no TCP control port, so nothing to expose or firewall.
    # rpz-update.sh and privacy-audit.sh both drive unbound through this.
    control-enable: yes
    control-interface: /run/unbound.ctl
    control-use-cert: no

# Resolution posture, rendered by bootstrap.sh from GALENA_FORWARD_UPSTREAMS.
# Empty when forward_tls_upstreams = [], which leaves unbound recursing.
${GALENA_FORWARD_BLOCK}

# Response policy zones are generated from the Terraform manifest, because order
# is semantic: the allowlist must come first. See bin/rpz-update.sh.
#
# RPZ is evaluated on this node regardless of posture, so the allowlist and the
# ad/tracker feed keep working while forwarding. What an allowlist CANNOT do is
# reverse a block made by the upstream: that NXDOMAIN arrives as an answer and
# never reaches response-policy processing. README documents the per-zone
# forward escape hatch for that case.
include-toplevel: "/etc/unbound/unbound.conf.d/galena-rpz.conf"
