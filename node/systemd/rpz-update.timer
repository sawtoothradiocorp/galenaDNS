[Unit]
Description=galena-dns: refresh RPZ blocklists on a schedule

[Timer]
# Hagezi rebuilds every 4-8h and stamps the files "Expires: 8 hours".
OnBootSec=3min
OnUnitActiveSec=${GALENA_RPZ_UPDATE_INTERVAL}
# Spread the load so every galena node on earth is not hitting the CDN at :00.
RandomizedDelaySec=30min
# No effect here, strictly: Persistent= only applies to OnCalendar= timers, and
# this one is monotonic. Catching up after downtime is OnBootSec=3min's job above.
# Kept so switching to OnCalendar later does not silently lose catch-up.
Persistent=true
Unit=rpz-update.service

[Install]
WantedBy=timers.target
