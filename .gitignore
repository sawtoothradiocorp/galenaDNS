# Terraform state — holds node addresses and resource IDs.
# (AWS credentials are deliberately NOT Terraform variables, so they are not here.)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# .terraform.lock.hcl IS committed on purpose: it pins provider checksums so
# everyone gets the same hcloud provider build.
# Saved plans embed variable values and every resource attribute. `make apply`
# deletes its plan, but an interrupted apply leaves one behind.
.tfplan
*.tfplan

crash.log
crash.*.log

# Variable files hold secrets; only the example is tracked
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Secrets
secrets/
*.pem
*.key
aws.credentials

# Generated client profiles embed your hostname
*.mobileconfig

# Local scratch
.env
*.local
scratch/
