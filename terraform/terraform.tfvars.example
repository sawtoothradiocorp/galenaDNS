# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# Secrets do NOT go in this file:
#   export HCLOUD_TOKEN=...            # Hetzner Cloud API token (read+write)
#   export AWS_ACCESS_KEY_ID=...       # Route 53 DNS-01, used by `make deploy` only
#   export AWS_SECRET_ACCESS_KEY=...

# Public hostname clients will point at. Must match the TLS cert and your SNI.
domain = "base.dns.swthrc.com"

# Let's Encrypt expiry notices.
acme_email = "you@example.com"

# The only inbound management path. Your current address, as a /32.
#   curl -4 https://ifconfig.co
admin_cidr = "203.0.113.4/32"   # placeholder (RFC 5737) - use your own

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# One node to start. Add a key to add a location — existing nodes are untouched.
nodes = {
  fsn1-a = { location = "fsn1" }
  # hel1-a = { location = "hel1" }
}

# --- Optional -------------------------------------------------------------

# Failover. With two or more nodes, Route 53 health checks on tcp/853 withdraw a
# dead node's address from DNS; without them a second node gives distribution but
# a client pinned to the dead one stays broken until it retries.
#
# Billable: $0.75/check/month, one check per node per address family. `make apply`
# includes it in the estimate it prints before you confirm. Ignored with one node.
# enable_dns_failover = true
#
# Halves that by checking IPv4 only, at the cost of not noticing v6-only breakage.
# dns_health_check_ipv6 = false
#
# Detection is interval * threshold; a client then waits out dns_record_ttl on top,
# so a long TTL is the thing that makes failover feel slow.
# dns_record_ttl = 60
# dns_health_check_interval = 30           # 10 costs $2.00/check more
# dns_health_check_failure_threshold = 3

# Alerting. Health-check failures, the external prober's findings, and the
# prober going silent all email this address. Empty disables alerting. See
# README "Monitoring" for the prober itself, which runs on monitor_host.
# alert_email  = "alerts@example.com"
# monitor_host = "monitor.example.com"      # an ssh destination, not a node

# Leave true for the first run to avoid burning Let's Encrypt rate limits while
# you shake out DNS-01. The cert will not be publicly trusted until you flip it.
# acme_staging = true

# Response-IP blocking is the most aggressive layer; set false to drop just it.
# enable_threat_ip_blocking = true

# Resolution posture. The default forwards to Quad9's FILTERED endpoint over
# authenticated DoT, which is where malware/phishing/C2 blocking comes from — see
# README "Design choices" for why this is preferred over full recursion.
#
# Own the entire blocking policy yourself instead: point at Quad9's unfiltered
# endpoint and add a malware feed back to rpz_blocklists.
# forward_tls_upstreams = [
#   "9.9.9.10@853#dns10.quad9.net",
#   "149.112.112.10@853#dns10.quad9.net",
#   "2620:fe::10@853#dns10.quad9.net",
# ]
# rpz_blocklists = [
#   { name = "adblock",  url = "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/rpz/pro.txt",         min_entries = 300000  },
#   { name = "threat",   url = "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/rpz/tif.medium.txt",  min_entries = 1000000 },
#   { name = "threatip", url = "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/rpz/tif-ips.txt",     min_entries = 20000   },
# ]
#
# Or full recursion from the root, with no third-party resolver at all. Read
# PRIVACY.md first: this hands the hosting provider every query name in cleartext.
# forward_tls_upstreams = []

# max_qps_per_ip = 40
# enable_localhost_metrics = false
